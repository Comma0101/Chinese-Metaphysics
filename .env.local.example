# Paid pilot stays closed unless every production control is configured.
PAID_PILOT_ENABLED=false

# Newsletter collection and all marketing sends remain disabled. Do not enable
# collection until immutable consent evidence, unsubscribe, and re-consent are
# implemented and reviewed. This switch does not enable sending. No marketing
# email may be sent from subscriber records.
NEWSLETTER_ENABLED=false

# Supabase transaction-pooler connection string. Server-only; never expose it
# through NEXT_PUBLIC_* variables.
SUPABASE_DATABASE_URL=

# JSON allowlist. Example:
# [{"country":"US","region":"Washington","city":"Seattle"}]
PILOT_ALLOWED_LOCATIONS=[]

# SHA-256 digest of the private pilot access code.
PILOT_ACCESS_CODE_HASH=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PostHog product analytics. Create a project at https://posthog.com and paste
# the project API key here. When unset, all tracking is a safe no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Canonical deployed origin; checkout never trusts the request Origin header.
# Also drives metadataBase / Open Graph / canonical. Set this in the Vercel
# build environment as well, e.g. https://meridian.kummalabs.com
NEXT_PUBLIC_SITE_URL=

# Resend transactional email. Only payment-safe facts are included in messages.
# Client applications and personal narratives are never stored in Resend error
# fields or logs. Resend necessarily receives the destination email address.
# Use disabled only for explicit local/test no-send operation. A live paid pilot
# refuses to start unless this is send and all Resend settings are valid.
NOTIFICATION_MODE=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=Meridian <notifications@example.com>
FOUNDER_NOTIFICATION_EMAIL=
SUPPORT_EMAIL=

# Secret presented by the scheduler as `Authorization: Bearer <CRON_SECRET>`.
# Use at least 16 random characters. The paid pilot stays closed without it.
CRON_SECRET=
